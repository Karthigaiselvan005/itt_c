CODE::
from itertools import product

# Read K (number of lists) and M (modulo value)
k, m = map(int, input().split())

# Read each list, skipping the first integer (which is the list size)
lists = []
for _ in range(k):
    # .split()[1:] ignores the count Ni and keeps only the elements
    elements = list(map(int, input().split()))[1:]
    lists.append(elements)

# Step 1: Pre-calculate the square of each element modulo M for efficiency
squared_lists = [[(x**2) % m for x in lst] for lst in lists]

# Step 2: Use product() to get every possible combination (X1, X2, ..., Xk)
# product(*squared_lists) behaves like nested for-loops
max_s = 0
for combo in product(*squared_lists):
    # Step 3: Sum the pre-squared values and apply modulo M
    current_s = sum(combo) % m
    if current_s > max_s:
        max_s = current_s

# Output the maximum value found
print(max_s)
